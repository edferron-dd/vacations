<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the Vacations site. `dotnet publish` keeps this file and fills in the
  aspNetCore element's processPath/arguments for the published app.

  Request flow: the URL Rewrite module runs before handler selection, so the /chat/* rule below
  hands those requests to ARR (proxying to the Python chatbot on 127.0.0.1:8001) and they never
  reach the ASP.NET Core Module. Everything else - /api/* and the static web UI - is served by
  ASP.NET Core. Requires URL Rewrite + ARR with the server-level proxy enabled (see infra/provision-ec2.ps1).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <rewrite>
        <rules>
          <rule name="Proxy chatbot" stopProcessing="true">
            <match url="^chat/(.*)" />
            <action type="Rewrite" url="http://127.0.0.1:8001/chat/{R:1}" appendQueryString="true" />
          </rule>
        </rules>
      </rewrite>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Vacations.Api.dll" stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
