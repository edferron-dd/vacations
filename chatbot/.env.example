# Copy to .env (never commit .env). On the server it lives at C:\apps\chatbot\.env, readable by Administrators/SYSTEM only.
ANTHROPIC_API_KEY=sk-ant-...

# Base URL of the .NET Vacations API. On the server IIS serves it on port 80; locally `dotnet run` uses 5000.
VACATIONS_API_URL=http://127.0.0.1
# VACATIONS_API_URL=http://localhost:5000

# Oracle connection for chat history (VACATION schema). deploy-app.ps1 keeps these in sync on the server.
ORACLE_USER=vacation
ORACLE_PASSWORD=change-me
ORACLE_DSN=localhost:1521/XEPDB1

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium            # low | medium | high | xhigh | max
# CLAUDE_FALLBACKS=default        # set to "off" to disable server-side refusal fallbacks
# CHAT_RETENTION_DAYS=30          # conversations untouched this long are deleted at startup
